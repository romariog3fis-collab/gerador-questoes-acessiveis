# OPENROUTER_API_KEY: Primary text/vision AI provider. Tries free (":free") models
# first (see app/api/generate/route.ts), then falls back to GROQ_API_KEY / GEMINI_API_KEY.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GROQ_API_KEY: Fallback text-only provider (used when OpenRouter is unavailable).
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Fallback provider, also required as the last resort for
# multimodal (PDF/image) requests if OpenRouter's free vision models fail.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# POLLINATIONS_API_KEY: Optional. Obtain a free key from pollinations.ai for better stability.
POLLINATIONS_API_KEY=""
